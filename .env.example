# URL publique du site (sitemap, Open Graph, données structurées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notifications e-mail via Resend (optionnel en local)
# Sans clé : en développement les demandes sont écrites dans .data/submissions.jsonl ;
# en production la demande est refusée (aucune fausse confirmation).
RESEND_API_KEY=
RESEND_FROM="Clario <notifications@votre-domaine.fr>"
CONTACT_EMAIL_TO=
